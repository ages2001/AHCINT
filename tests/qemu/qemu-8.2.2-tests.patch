diff -ruN a/hw/pci-host/intel_vmd.c b/hw/pci-host/intel_vmd.c
--- a/hw/pci-host/intel_vmd.c	1970-01-01 02:00:00.000000000 +0200
+++ b/hw/pci-host/intel_vmd.c	2026-11-23 08:22:55.425012093 +0300
@@ -0,0 +1,264 @@
+/*
+ * Intel Volume Management Device (VMD) test model
+ *
+ * A PCI endpoint (class 01:04) that hides a PCI domain of its own:
+ *   BAR0 (CFGBAR)  ECAM of the domain, bus "bus-start" at offset 0
+ *   BAR2 (MEMBAR1) window on the domain's memory space
+ *   BAR4 (MEMBAR2) window on the domain's memory space from offset 0x2000
+ *   40h VMCAP (bus restriction capability), 44h VMCONFIG (bits 9:8 bus
+ *   start: 0, 128, 224; bit 1 MSI remap off), 70h VMLOCK
+ * The domain's devices are reached only through the BARs: the firmware does
+ * not see them, so their BARs and the bridges in it start unprogrammed, as
+ * under a legacy BIOS. Their INTx goes nowhere (the real VMD routes only
+ * MSI/MSI-X); their bus mastering reaches system memory.
+ * Devices go on the bus "<id>.0": -device intel-vmd,id=vmd
+ * -device pci-bridge,id=vb,chassis_nr=9,bus=vmd.0 -device nvme,bus=vb,...
+ * (endpoints may also sit on vmd.0 itself, e.g. ich9-ahci,bus=vmd.0,addr=0x17)
+ * Modeled on Linux drivers/pci/controller/vmd.c.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/pci/pci_device.h"
+#include "hw/pci/msix.h"
+#include "hw/pci/pci_bus.h"
+#include "hw/pci/pci_host.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "exec/address-spaces.h"
+#include "qom/object.h"
+
+PCIBus *pci_find_bus_nr(PCIBus *bus, int bus_num);   /* hw/pci/pci-internal.h */
+
+#define TYPE_INTEL_VMD "intel-vmd"
+#define TYPE_INTEL_VMD_HOST "intel-vmd-host"
+#define TYPE_INTEL_VMD_BUS "intel-vmd-bus"
+
+OBJECT_DECLARE_SIMPLE_TYPE(IntelVMDState, INTEL_VMD)
+
+struct IntelVMDState {
+    PCIDevice parent_obj;
+    MemoryRegion cfgbar, membar1, membar2, membar2c;
+    MemoryRegion mem, io;
+    AddressSpace child_as;
+    PCIBus *bus;
+    uint16_t device_id;
+    uint8_t bus_start;
+    uint32_t cfgbar_mb, membar1_mb;
+    bool intx;
+    uint32_t msix_vectors;
+};
+
+/* the domain's root bus: no parent device (so that endpoints may sit on it,
+   as the SATA controller does on real hardware), its first bus number kept here */
+typedef struct IntelVMDBus {
+    PCIBus parent_obj;
+    uint8_t bus_start;
+} IntelVMDBus;
+
+static int vmd_bus_num(PCIBus *bus)
+{
+    return ((IntelVMDBus *)bus)->bus_start;
+}
+
+static void vmd_bus_class_init(ObjectClass *klass, void *data)
+{
+    PCIBusClass *pbc = PCI_BUS_CLASS(klass);
+    pbc->bus_num = vmd_bus_num;
+}
+
+static const TypeInfo vmd_bus_info = {
+    .name = TYPE_INTEL_VMD_BUS,
+    .parent = TYPE_PCI_BUS,
+    .instance_size = sizeof(IntelVMDBus),
+    .class_init = vmd_bus_class_init,
+};
+
+static void vmd_host_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->user_creatable = false;
+}
+
+static const TypeInfo vmd_host_info = {
+    .name = TYPE_INTEL_VMD_HOST,
+    .parent = TYPE_PCI_HOST_BRIDGE,
+    .class_init = vmd_host_class_init,
+};
+
+static PCIDevice *vmd_cfg_dev(IntelVMDState *s, hwaddr addr)
+{
+    PCIBus *b = pci_find_bus_nr(s->bus, s->bus_start + (int)(addr >> 20));
+    if (!b || (s->bus_start + (addr >> 20)) > 255) {
+        return NULL;
+    }
+    return b->devices[(addr >> 12) & 0xff];
+}
+
+static uint64_t vmd_cfg_read(void *opaque, hwaddr addr, unsigned size)
+{
+    IntelVMDState *s = opaque;
+    PCIDevice *d = vmd_cfg_dev(s, addr);
+    if (!d) {
+        return size == 4 ? 0xffffffffu : (1u << (size * 8)) - 1;
+    }
+    return pci_host_config_read_common(d, addr & 0xfff, pci_config_size(d), size);
+}
+
+static void vmd_cfg_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    IntelVMDState *s = opaque;
+    PCIDevice *d = vmd_cfg_dev(s, addr);
+    if (d) {
+        pci_host_config_write_common(d, addr & 0xfff, pci_config_size(d), val, size);
+    }
+}
+
+static const MemoryRegionOps vmd_cfg_ops = {
+    .read = vmd_cfg_read,
+    .write = vmd_cfg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static uint64_t vmd_win_rw(IntelVMDState *s, int bar, hwaddr addr, uint64_t val,
+                           unsigned size, bool write)
+{
+    PCIDevice *pd = PCI_DEVICE(s);
+    pcibus_t base = pci_get_bar_addr(pd, bar);
+    uint8_t buf[8];
+    if (base == PCI_BAR_UNMAPPED) {
+        return ~0ull;
+    }
+    if (write) {
+        stn_le_p(buf, size, val);
+        address_space_write(&s->child_as, base + addr, MEMTXATTRS_UNSPECIFIED, buf, size);
+        return 0;
+    }
+    if (address_space_read(&s->child_as, base + addr, MEMTXATTRS_UNSPECIFIED, buf, size) != MEMTX_OK) {
+        return ~0ull;
+    }
+    return ldn_le_p(buf, size);
+}
+
+static uint64_t vmd_m1_read(void *o, hwaddr a, unsigned sz) { return vmd_win_rw(o, 2, a, 0, sz, false); }
+static void vmd_m1_write(void *o, hwaddr a, uint64_t v, unsigned sz) { vmd_win_rw(o, 2, a, v, sz, true); }
+static uint64_t vmd_m2_read(void *o, hwaddr a, unsigned sz) { return vmd_win_rw(o, 4, a + 0x2000, 0, sz, false); }
+static void vmd_m2_write(void *o, hwaddr a, uint64_t v, unsigned sz) { vmd_win_rw(o, 4, a + 0x2000, v, sz, true); }
+
+static const MemoryRegionOps vmd_m1_ops = {
+    .read = vmd_m1_read, .write = vmd_m1_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8 },
+    .impl = { .min_access_size = 1, .max_access_size = 8 },
+};
+
+static const MemoryRegionOps vmd_m2_ops = {
+    .read = vmd_m2_read, .write = vmd_m2_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8 },
+    .impl = { .min_access_size = 1, .max_access_size = 8 },
+};
+
+static void vmd_set_irq(void *opaque, int irq, int level)
+{
+    /* INTx of the domain's devices is not routed */
+}
+
+static int vmd_map_irq(PCIDevice *d, int pin)
+{
+    return pin;
+}
+
+static void vmd_realize(PCIDevice *pd, Error **errp)
+{
+    IntelVMDState *s = INTEL_VMD(pd);
+    DeviceState *host;
+    const char *id = DEVICE(pd)->id ? DEVICE(pd)->id : "vmd";
+    g_autofree char *busname = g_strdup_printf("%s.0", id);
+    uint16_t cfg = s->bus_start >= 224 ? 2 : s->bus_start >= 128 ? 1 : 0;
+
+    s->bus_start = cfg == 2 ? 224 : cfg == 1 ? 128 : 0;
+    pci_config_set_vendor_id(pd->config, PCI_VENDOR_ID_INTEL);
+    pci_config_set_device_id(pd->config, s->device_id);
+    pci_config_set_class(pd->config, 0x0104);
+    pci_config_set_prog_interface(pd->config, 0);
+    pci_config_set_interrupt_pin(pd->config, s->intx ? 1 : 0);   /* test: an INTA# pin */
+    pci_set_word(pd->config + 0x40, 1);                 /* VMCAP: bus restriction */
+    pci_set_word(pd->config + 0x44, cfg << 8);          /* VMCONFIG */
+    pci_set_word(pd->wmask + 0x44, 0x0302);
+    pci_set_long(pd->config + 0x70, 0);                 /* VMLOCK */
+
+    memory_region_init(&s->mem, OBJECT(s), "vmd-domain-mem", UINT64_MAX);
+    memory_region_init(&s->io, OBJECT(s), "vmd-domain-io", 0x10000);
+    address_space_init(&s->child_as, &s->mem, "vmd-domain");
+
+    memory_region_init_io(&s->cfgbar, OBJECT(s), &vmd_cfg_ops, s, "vmd-cfgbar",
+                          (uint64_t)s->cfgbar_mb << 20);
+    memory_region_init_io(&s->membar1, OBJECT(s), &vmd_m1_ops, s, "vmd-membar1",
+                          (uint64_t)s->membar1_mb << 20);
+    /* MEMBAR2: the VMD's own MSI-X table and PBA first (as on hardware), the
+       domain's window from 2000h */
+    memory_region_init(&s->membar2c, OBJECT(s), "vmd-membar2", 1 << 20);
+    memory_region_init_io(&s->membar2, OBJECT(s), &vmd_m2_ops, s, "vmd-membar2-window", (1 << 20) - 0x2000);
+    memory_region_add_subregion(&s->membar2c, 0x2000, &s->membar2);
+    pci_register_bar(pd, 0, PCI_BASE_ADDRESS_SPACE_MEMORY | PCI_BASE_ADDRESS_MEM_TYPE_64, &s->cfgbar);
+    pci_register_bar(pd, 2, PCI_BASE_ADDRESS_SPACE_MEMORY | PCI_BASE_ADDRESS_MEM_TYPE_64, &s->membar1);
+    pci_register_bar(pd, 4, PCI_BASE_ADDRESS_SPACE_MEMORY | PCI_BASE_ADDRESS_MEM_TYPE_64, &s->membar2c);
+    if (s->msix_vectors &&
+        msix_init(pd, s->msix_vectors, &s->membar2c, 4, 0, &s->membar2c, 4, 0x1000, 0x80, errp) < 0) {
+        return;
+    }
+
+    host = qdev_new(TYPE_INTEL_VMD_HOST);
+    s->bus = pci_root_bus_new(host, busname, &s->mem, &s->io, 0, TYPE_INTEL_VMD_BUS);
+    ((IntelVMDBus *)s->bus)->bus_start = s->bus_start;
+    pci_bus_irqs(s->bus, vmd_set_irq, s, PCI_NUM_PINS);
+    pci_bus_map_irqs(s->bus, vmd_map_irq);
+    PCI_HOST_BRIDGE(host)->bus = s->bus;
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(host), &error_fatal);
+}
+
+static Property vmd_props[] = {
+    DEFINE_PROP_UINT16("device-id", IntelVMDState, device_id, 0x9a0b),
+    DEFINE_PROP_UINT8("bus-start", IntelVMDState, bus_start, 224),
+    DEFINE_PROP_UINT32("cfgbar-mb", IntelVMDState, cfgbar_mb, 32),
+    DEFINE_PROP_UINT32("membar1-mb", IntelVMDState, membar1_mb, 32),
+    DEFINE_PROP_BOOL("intx", IntelVMDState, intx, false),
+    DEFINE_PROP_UINT32("msix-vectors", IntelVMDState, msix_vectors, 32),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void vmd_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    k->realize = vmd_realize;
+    k->vendor_id = PCI_VENDOR_ID_INTEL;
+    k->device_id = 0x9a0b;
+    k->class_id = 0x0104;
+    device_class_set_props(dc, vmd_props);
+    set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
+}
+
+static const TypeInfo vmd_info = {
+    .name = TYPE_INTEL_VMD,
+    .parent = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(IntelVMDState),
+    .class_init = vmd_class_init,
+    .interfaces = (InterfaceInfo[]) {
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { },
+    },
+};
+
+static void vmd_register_types(void)
+{
+    type_register_static(&vmd_bus_info);
+    type_register_static(&vmd_host_info);
+    type_register_static(&vmd_info);
+}
+
+type_init(vmd_register_types)
