diff -ruN a/hw/ide/ichide.c b/hw/ide/ichide.c
--- a/hw/ide/ichide.c	1970-01-01 02:00:00.000000000 +0200
+++ b/hw/ide/ichide.c	2026-11-16 02:25:31.101471974 +0300
@@ -0,0 +1,555 @@
+/*
+ * Intel ICH/PCH IDE functions for driver tests: the ICH5 PATA (24DB) and
+ * SATA (24D1) functions with combined mode, and the 6/7-series PCH SATA
+ * controllers in IDE mode (1E00 ports 0-3, 1E08 ports 4-5).
+ *
+ * What the model keeps of the silicon:
+ *  - IDETIM decode enable (41h/43h bit 7) and the command register's I/O
+ *    enable gate a channel; a gated channel's ports are not decoded at all
+ *  - compatibility channels decode 1F0h/3F6h and 170h/376h only when the
+ *    function owns them ("legacy-mask"; ICH5 combined mode gives one legacy
+ *    channel to each function, by MAP at 90h of the SATA function)
+ *  - native channels decode BARs 0-3 and raise INTA; compatibility channels
+ *    raise ISA IRQ 14/15
+ *  - the board BIOS sets the decode enables of the channels in use
+ *    ("bios-decode"); SeaBIOS does that for the PIIX IDs only
+ *  - SATA ports: the task file of a port without a device reads 7Fh
+ *  - a disk stays busy after a software reset and after power-on for the
+ *    given time ("reset-busy-ms", "poweron-busy-ms"), as real drives do
+ *  - PCS (92h) shows the ports with a device as present and enabled
+ *
+ * Also a configurable stub function ("ich-stub"): the LPC bridge at 1F.0
+ * that makes device 31 multi-function, SMBus, a display controller with
+ * an I/O BAR, as on the boards (their BARs take I/O space next to the IDE
+ * ones).
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/pci/pci.h"
+#include "hw/qdev-properties.h"
+#include "hw/isa/isa.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "qemu/range.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "sysemu/dma.h"
+#include "hw/ide/pci.h"
+#include "hw/irq.h"
+
+#define TYPE_ICH_IDE "ich-ide"
+OBJECT_DECLARE_SIMPLE_TYPE(ICHIDEState, ICH_IDE)
+
+typedef struct ICHChannel {
+    struct ICHIDEState *s;
+    int ch;
+    MemoryRegion legacy_cmd;
+    MemoryRegion legacy_ctl;
+    bool legacy_added;
+    int64_t busy_until;
+    uint8_t ctl;
+    int level;
+} ICHChannel;
+
+struct ICHIDEState {
+    PCIIDEState parent_obj;
+
+    ICHChannel chan[2];
+    uint16_t device_id;
+    uint8_t revision;
+    uint32_t subsys;
+    uint8_t prog_if;
+    uint8_t legacy_mask;
+    uint8_t map;
+    bool bios_decode;
+    bool bios_dma;
+    bool keep_bars;
+    bool sata;
+    uint32_t reset_busy_ms;
+    uint32_t poweron_busy_ms;
+};
+
+static bool ich_native(ICHIDEState *s, int ch)
+{
+    return PCI_DEVICE(s)->config[PCI_CLASS_PROG] & (ch ? 4 : 1);
+}
+
+static bool ich_decode(ICHIDEState *s, int ch)
+{
+    uint8_t *c = PCI_DEVICE(s)->config;
+    return (c[ch ? 0x43 : 0x41] & 0x80) && (c[PCI_COMMAND] & PCI_COMMAND_IO);
+}
+
+static void ich_update_decode(ICHIDEState *s)
+{
+    PCIIDEState *d = PCI_IDE(s);
+    int ch;
+
+    for (ch = 0; ch < 2; ch++) {
+        bool native = ich_native(s, ch), dec = ich_decode(s, ch);
+        bool legacy = !native && dec && (s->legacy_mask & (1 << ch));
+        memory_region_set_enabled(&s->chan[ch].legacy_cmd, legacy);
+        memory_region_set_enabled(&s->chan[ch].legacy_ctl, legacy);
+        memory_region_set_enabled(&d->data_bar[ch], native && dec);
+        memory_region_set_enabled(&d->cmd_bar[ch], native && dec);
+    }
+}
+
+static bool ich_busy(ICHChannel *c)
+{
+    return c->busy_until && qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) < c->busy_until;
+}
+
+/* SATA: a port without a device has a task file reading 7Fh */
+static bool ich_absent(ICHChannel *c)
+{
+    IDEBus *bus = &PCI_IDE(c->s)->bus[c->ch];
+    return c->s->sata && !bus->ifs[bus->unit].blk;
+}
+
+static uint64_t ich_cmd_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ICHChannel *c = opaque;
+    IDEBus *bus = &PCI_IDE(c->s)->bus[c->ch];
+
+    if (ich_busy(c)) {
+        return size == 1 ? 0x80 : (size == 2 ? 0x8080 : 0x80808080);
+    }
+    if (ich_absent(c)) {
+        return size == 1 ? 0x7f : (size == 2 ? 0x7f7f : 0x7f7f7f7f);
+    }
+    if (size == 1) {
+        return ide_ioport_read(bus, addr);
+    } else if (addr == 0) {
+        return size == 2 ? ide_data_readw(bus, addr) : ide_data_readl(bus, addr);
+    }
+    return ((uint64_t)1 << (size * 8)) - 1;
+}
+
+static void ich_cmd_write(void *opaque, hwaddr addr, uint64_t data, unsigned size)
+{
+    ICHChannel *c = opaque;
+    IDEBus *bus = &PCI_IDE(c->s)->bus[c->ch];
+
+    if (ich_busy(c)) {
+        return;
+    }
+    if (size == 1) {
+        ide_ioport_write(bus, addr, data);
+    } else if (addr == 0) {
+        if (size == 2) {
+            ide_data_writew(bus, addr, data);
+        } else {
+            ide_data_writel(bus, addr, data);
+        }
+    }
+}
+
+static const MemoryRegionOps ich_cmd_ops = {
+    .read = ich_cmd_read,
+    .write = ich_cmd_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+/* The control block: Offset is 0 for the legacy port (3F6h/376h), 2 in
+   the native 4-byte BAR */
+static uint64_t ich_ctl_read_at(ICHChannel *c, hwaddr off, unsigned size)
+{
+    IDEBus *bus = &PCI_IDE(c->s)->bus[c->ch];
+
+    if (off != 0 || size != 1) {
+        return ((uint64_t)1 << (size * 8)) - 1;
+    }
+    if (ich_busy(c)) {
+        return 0x80;
+    }
+    if (ich_absent(c)) {
+        return 0x7f;
+    }
+    return ide_status_read(bus, 0);
+}
+
+static void ich_ctl_write_at(ICHChannel *c, hwaddr off, uint64_t data, unsigned size)
+{
+    IDEBus *bus = &PCI_IDE(c->s)->bus[c->ch];
+
+    if (off != 0 || size != 1) {
+        return;
+    }
+    /* SRST released: the drives run their diagnostics */
+    if ((c->ctl & 0x04) && !(data & 0x04) && c->s->reset_busy_ms) {
+        c->busy_until = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + c->s->reset_busy_ms;
+    }
+    c->ctl = data;
+    ide_ctrl_write(bus, 0, data);
+}
+
+static uint64_t ich_legacy_ctl_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return ich_ctl_read_at(opaque, addr, size);
+}
+
+static void ich_legacy_ctl_write(void *opaque, hwaddr addr, uint64_t data, unsigned size)
+{
+    ich_ctl_write_at(opaque, addr, data, size);
+}
+
+static const MemoryRegionOps ich_legacy_ctl_ops = {
+    .read = ich_legacy_ctl_read,
+    .write = ich_legacy_ctl_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static uint64_t ich_bar_ctl_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return ich_ctl_read_at(opaque, addr - 2, size);
+}
+
+static void ich_bar_ctl_write(void *opaque, hwaddr addr, uint64_t data, unsigned size)
+{
+    ich_ctl_write_at(opaque, addr - 2, data, size);
+}
+
+static const MemoryRegionOps ich_bar_ctl_ops = {
+    .read = ich_bar_ctl_read,
+    .write = ich_bar_ctl_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+/* Bus master: as the PIIX */
+static uint64_t ich_bmdma_read(void *opaque, hwaddr addr, unsigned size)
+{
+    BMDMAState *bm = opaque;
+
+    if (size != 1) {
+        return ((uint64_t)1 << (size * 8)) - 1;
+    }
+    switch (addr & 3) {
+    case 0:
+        return bm->cmd;
+    case 2:
+        return bm->status;
+    default:
+        return 0xff;
+    }
+}
+
+static void ich_bmdma_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    BMDMAState *bm = opaque;
+
+    if (size != 1) {
+        return;
+    }
+    switch (addr & 3) {
+    case 0:
+        bmdma_cmd_writeb(bm, val);
+        break;
+    case 2:
+        bmdma_status_writeb(bm, val);
+        break;
+    }
+}
+
+static const MemoryRegionOps ich_bmdma_ops = {
+    .read = ich_bmdma_read,
+    .write = ich_bmdma_write,
+};
+
+static void ich_set_irq(void *opaque, int n, int level)
+{
+    ICHIDEState *s = opaque;
+    PCIIDEState *d = PCI_IDE(s);
+    int i, pci = 0;
+
+    s->chan[n].level = level;
+    if (!ich_native(s, n)) {
+        qemu_set_irq(d->isa_irq[n], level);
+    }
+    for (i = 0; i < 2; i++) {
+        if (ich_native(s, i) && s->chan[i].level) {
+            pci = 1;
+        }
+    }
+    pci_set_irq(PCI_DEVICE(s), pci);
+}
+
+static void ich_ide_reset(DeviceState *dev)
+{
+    ICHIDEState *s = ICH_IDE(dev);
+    PCIIDEState *d = PCI_IDE(dev);
+    PCIDevice *pd = PCI_DEVICE(dev);
+    uint8_t *conf = pd->config;
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        ide_bus_reset(&d->bus[i]);
+        s->chan[i].ctl = 0;
+        s->chan[i].level = 0;
+        s->chan[i].busy_until = s->poweron_busy_ms ?
+            qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + s->poweron_busy_ms : 0;
+    }
+    pci_set_word(conf + PCI_COMMAND, 0);
+    pci_set_word(conf + PCI_STATUS, PCI_STATUS_DEVSEL_MEDIUM | PCI_STATUS_FAST_BACK);
+    conf[PCI_CLASS_PROG] = s->prog_if;
+    memset(conf + 0x40, 0, 0x60);
+    if (s->bios_decode) {
+        /* What the board's BIOS leaves: the decode enable of every channel
+           this function has (combined mode: only its own legacy channel) */
+        for (i = 0; i < 2; i++) {
+            if ((s->prog_if & (i ? 4 : 1)) || (s->legacy_mask & (1 << i))) {
+                conf[i ? 0x43 : 0x41] = 0x80;
+            }
+        }
+    }
+    if (s->bios_dma) {
+        /* The BIOS marks the drives it set up for DMA (bus master status
+           bits 5/6), as SeaBIOS does not */
+        for (i = 0; i < 2; i++) {
+            if (d->bus[i].ifs[0].blk) {
+                d->bmdma[i].status |= 0x20;
+            }
+            if (d->bus[i].ifs[1].blk) {
+                d->bmdma[i].status |= 0x40;
+            }
+        }
+    }
+    conf[0x90] = s->map;
+    if (s->sata) {
+        uint16_t pcs = 0;
+        int ch, u;
+        /* ports: ICH5 P0 = primary master, P1 = secondary master
+           (combined mode P0/P1 = master/slave); PCH 1E00 P0/P2 primary,
+           P1/P3 secondary */
+        for (ch = 0; ch < 2; ch++) {
+            for (u = 0; u < 2; u++) {
+                if (d->bus[ch].ifs[u].blk) {
+                    int port = (s->map >= 4) ? u : (ch + 2 * u);
+                    pcs |= (1 << port) | (0x100 << port);
+                }
+            }
+        }
+        pci_set_word(conf + 0x92, pcs);
+    }
+    ich_update_decode(s);
+}
+
+static void ich_ide_cfg_write(PCIDevice *pd, uint32_t addr, uint32_t val, int len)
+{
+    /* SeaBIOS moves the BARs 0-3 of a native-mode IDE function other than
+       the PIIX to 1F0h/3F4h/170h/374h after it allocated them; a board's
+       BIOS keeps them where it put them. */
+    if (ICH_IDE(pd)->keep_bars && len == 4 && addr >= PCI_BASE_ADDRESS_0 && addr <= PCI_BASE_ADDRESS_3) {
+        uint32_t a = val & ~3u, cur = pci_get_long(pd->config + addr) & ~3u;
+        if ((a == 0x1f0 || a == 0x3f4 || a == 0x170 || a == 0x374) && cur != 0 && cur != 0xfffffffcu) {
+            val = cur | 1;
+        }
+    }
+    pci_default_write_config(pd, addr, val, len);
+    if (ranges_overlap(addr, len, PCI_COMMAND, 2) ||
+        ranges_overlap(addr, len, PCI_CLASS_PROG, 1) ||
+        ranges_overlap(addr, len, 0x40, 4)) {
+        ich_update_decode(ICH_IDE(pd));
+    }
+}
+
+static void ich_ide_realize(PCIDevice *dev, Error **errp)
+{
+    ICHIDEState *s = ICH_IDE(dev);
+    PCIIDEState *d = PCI_IDE(dev);
+    DeviceState *ds = DEVICE(dev);
+    uint8_t *conf = dev->config;
+    MemoryRegion *io = pci_address_space_io(dev);
+    int i;
+
+    pci_config_set_device_id(conf, s->device_id);
+    pci_config_set_revision(conf, s->revision);
+    pci_set_long(conf + PCI_SUBSYSTEM_VENDOR_ID, s->subsys);
+    pci_config_set_interrupt_pin(conf, 1);
+    /* only the programmable bits (0 and 2) of the programming interface */
+    dev->wmask[PCI_CLASS_PROG] = ((s->prog_if & 2) ? 1 : 0) | ((s->prog_if & 8) ? 4 : 0);
+    dev->wmask[0x90] = 0;
+    dev->wmask[0x92] = 0x0f;
+    dev->wmask[0x93] = 0;
+
+    for (i = 0; i < 2; i++) {
+        ICHChannel *c = &s->chan[i];
+        c->s = s;
+        c->ch = i;
+        memory_region_init_io(&d->data_bar[i], OBJECT(d), &ich_cmd_ops, c, "ich-ide-cmd", 8);
+        pci_register_bar(dev, 2 * i, PCI_BASE_ADDRESS_SPACE_IO, &d->data_bar[i]);
+        memory_region_init_io(&d->cmd_bar[i], OBJECT(d), &ich_bar_ctl_ops, c, "ich-ide-ctl", 4);
+        pci_register_bar(dev, 2 * i + 1, PCI_BASE_ADDRESS_SPACE_IO, &d->cmd_bar[i]);
+
+        memory_region_init_io(&c->legacy_cmd, OBJECT(d), &ich_cmd_ops, c, "ich-ide-legacy", 8);
+        memory_region_add_subregion_overlap(io, i ? 0x170 : 0x1f0, &c->legacy_cmd, 1);
+        memory_region_init_io(&c->legacy_ctl, OBJECT(d), &ich_legacy_ctl_ops, c, "ich-ide-legacy-ctl", 1);
+        memory_region_add_subregion_overlap(io, i ? 0x376 : 0x3f6, &c->legacy_ctl, 1);
+    }
+
+    memory_region_init(&d->bmdma_bar, OBJECT(d), "ich-bmdma-container", 16);
+    for (i = 0; i < 2; i++) {
+        BMDMAState *bm = &d->bmdma[i];
+        memory_region_init_io(&bm->extra_io, OBJECT(d), &ich_bmdma_ops, bm, "ich-bmdma", 4);
+        memory_region_add_subregion(&d->bmdma_bar, i * 8, &bm->extra_io);
+        memory_region_init_io(&bm->addr_ioport, OBJECT(d), &bmdma_addr_ioport_ops, bm, "bmdma", 4);
+        memory_region_add_subregion(&d->bmdma_bar, i * 8 + 4, &bm->addr_ioport);
+    }
+    pci_register_bar(dev, 4, PCI_BASE_ADDRESS_SPACE_IO, &d->bmdma_bar);
+
+    qdev_init_gpio_in(ds, ich_set_irq, 2);
+    for (i = 0; i < 2; i++) {
+        d->isa_irq[i] = isa_get_irq(NULL, 14 + i);
+        ide_bus_init(&d->bus[i], sizeof(d->bus[i]), ds, i, MAX_IDE_DEVS);
+        ide_bus_init_output_irq(&d->bus[i], qdev_get_gpio_in(ds, i));
+        bmdma_init(&d->bus[i], &d->bmdma[i], d);
+        ide_bus_register_restart_cb(&d->bus[i]);
+    }
+}
+
+static void ich_ide_exitfn(PCIDevice *dev)
+{
+    ICHIDEState *s = ICH_IDE(dev);
+    PCIIDEState *d = PCI_IDE(dev);
+    MemoryRegion *io = pci_address_space_io(dev);
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        memory_region_del_subregion(io, &s->chan[i].legacy_cmd);
+        memory_region_del_subregion(io, &s->chan[i].legacy_ctl);
+        memory_region_del_subregion(&d->bmdma_bar, &d->bmdma[i].extra_io);
+        memory_region_del_subregion(&d->bmdma_bar, &d->bmdma[i].addr_ioport);
+    }
+}
+
+static Property ich_ide_props[] = {
+    DEFINE_PROP_UINT16("device-id", ICHIDEState, device_id, 0x24db),
+    DEFINE_PROP_UINT8("revision", ICHIDEState, revision, 0x02),
+    DEFINE_PROP_UINT32("subsys", ICHIDEState, subsys, 0),
+    DEFINE_PROP_UINT8("prog-if", ICHIDEState, prog_if, 0x8a),
+    DEFINE_PROP_UINT8("legacy-mask", ICHIDEState, legacy_mask, 3),
+    DEFINE_PROP_UINT8("map", ICHIDEState, map, 0),
+    DEFINE_PROP_BOOL("bios-decode", ICHIDEState, bios_decode, true),
+    DEFINE_PROP_BOOL("bios-dma", ICHIDEState, bios_dma, true),
+    DEFINE_PROP_BOOL("keep-bars", ICHIDEState, keep_bars, true),
+    DEFINE_PROP_BOOL("sata", ICHIDEState, sata, false),
+    DEFINE_PROP_UINT32("reset-busy-ms", ICHIDEState, reset_busy_ms, 0),
+    DEFINE_PROP_UINT32("poweron-busy-ms", ICHIDEState, poweron_busy_ms, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void ich_ide_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    dc->reset = ich_ide_reset;
+    dc->vmsd = &vmstate_ide_pci;
+    device_class_set_props(dc, ich_ide_props);
+    k->config_write = ich_ide_cfg_write;
+    k->realize = ich_ide_realize;
+    k->exit = ich_ide_exitfn;
+    k->vendor_id = PCI_VENDOR_ID_INTEL;
+    k->device_id = 0x24db;
+    k->class_id = PCI_CLASS_STORAGE_IDE;
+    set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
+}
+
+static const TypeInfo ich_ide_info = {
+    .name          = TYPE_ICH_IDE,
+    .parent        = TYPE_PCI_IDE,
+    .instance_size = sizeof(ICHIDEState),
+    .class_init    = ich_ide_class_init,
+};
+
+/* ------------------------------------------------------------------ */
+/* Stub function: LPC bridge, SMBus, display controller                */
+
+#define TYPE_ICH_STUB "ich-stub"
+OBJECT_DECLARE_SIMPLE_TYPE(ICHStubState, ICH_STUB)
+
+struct ICHStubState {
+    PCIDevice parent_obj;
+    uint16_t vendor_id;
+    uint16_t device_id;
+    uint8_t revision;
+    uint32_t class_code;
+    uint32_t io_size;
+    uint32_t subsys;
+    MemoryRegion io;
+};
+
+static uint64_t ich_stub_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return 0;
+}
+
+static void ich_stub_write(void *opaque, hwaddr addr, uint64_t data, unsigned size)
+{
+}
+
+static const MemoryRegionOps ich_stub_ops = {
+    .read = ich_stub_read,
+    .write = ich_stub_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void ich_stub_realize(PCIDevice *dev, Error **errp)
+{
+    ICHStubState *s = ICH_STUB(dev);
+    uint8_t *conf = dev->config;
+
+    pci_config_set_vendor_id(conf, s->vendor_id);
+    pci_config_set_device_id(conf, s->device_id);
+    pci_config_set_revision(conf, s->revision);
+    pci_config_set_prog_interface(conf, s->class_code & 0xff);
+    pci_config_set_class(conf, s->class_code >> 8);
+    pci_set_long(conf + PCI_SUBSYSTEM_VENDOR_ID, s->subsys);
+    if (s->io_size) {
+        memory_region_init_io(&s->io, OBJECT(s), &ich_stub_ops, s, "ich-stub-io", s->io_size);
+        pci_register_bar(dev, 4, PCI_BASE_ADDRESS_SPACE_IO, &s->io);
+    }
+}
+
+static Property ich_stub_props[] = {
+    DEFINE_PROP_UINT16("vendor-id", ICHStubState, vendor_id, 0x8086),
+    DEFINE_PROP_UINT16("device-id", ICHStubState, device_id, 0x24d0),
+    DEFINE_PROP_UINT8("revision", ICHStubState, revision, 0x02),
+    DEFINE_PROP_UINT32("class", ICHStubState, class_code, 0x060100),
+    DEFINE_PROP_UINT32("io-size", ICHStubState, io_size, 0),
+    DEFINE_PROP_UINT32("subsys", ICHStubState, subsys, 0),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void ich_stub_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+
+    device_class_set_props(dc, ich_stub_props);
+    k->realize = ich_stub_realize;
+    k->vendor_id = PCI_VENDOR_ID_INTEL;
+    k->device_id = 0x24d0;
+    k->class_id = PCI_CLASS_BRIDGE_ISA;
+}
+
+static const TypeInfo ich_stub_info = {
+    .name          = TYPE_ICH_STUB,
+    .parent        = TYPE_PCI_DEVICE,
+    .instance_size = sizeof(ICHStubState),
+    .class_init    = ich_stub_class_init,
+    .interfaces = (InterfaceInfo[]) {
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { },
+    },
+};
+
+static void ich_ide_register_types(void)
+{
+    type_register_static(&ich_ide_info);
+    type_register_static(&ich_stub_info);
+}
+
+type_init(ich_ide_register_types)
