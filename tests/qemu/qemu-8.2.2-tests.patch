+/* Test hook QEMU_AHCI_STRICT: a PRD entry as an HBA takes it, with bit 0
+   of the data base address and of the byte count ignored (AHCI 1.3,
+   4.2.3.3: DBA bit 0 reserved, DBC bit 0 must be 1); every entry that
+   breaks the rule is logged. */
+static bool ahci_strict(void)
+{
+    static int s = -1;
+    if (s < 0) {
+        s = getenv("QEMU_AHCI_STRICT") != NULL;
+    }
+    return s;
+}
+
 static int prdt_tbl_entry_size(const AHCI_SG *tbl)
 {
     /* flags_size is zero-based */
-    return (le32_to_cpu(tbl->flags_size) & AHCI_PRDT_SIZE_MASK) + 1;
+    uint32_t dbc = le32_to_cpu(tbl->flags_size) & AHCI_PRDT_SIZE_MASK;
+    if (ahci_strict()) {
+        dbc |= 1;
+    }
+    return dbc + 1;
+}
+
+static uint16_t ahci_strict_opts;
+
+static uint64_t prdt_tbl_entry_addr(const AHCI_SG *tbl)
+{
+    uint64_t a = le64_to_cpu(tbl->addr);
+    if (ahci_strict()) {
+        uint32_t dbc = le32_to_cpu(tbl->flags_size) & AHCI_PRDT_SIZE_MASK;
+        if ((a & 1) || !(dbc & 1)) {
+            static unsigned long n;
+            if (n++ < 200) {
+                fprintf(stderr, "AHCI-STRICT: PRD entry addr %" PRIx64 " count %u breaks word alignment (%s)\n",
+                        a, dbc + 1, (ahci_strict_opts & AHCI_CMD_WRITE) ? "write" : "read");
+            }
+        }
+        a &= ~1ULL;
+    }
+    return a;
 }
 
