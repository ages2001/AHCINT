diff -ruN a/hw/ide/ich.c b/hw/ide/ich.c
--- a/hw/ide/ich.c	2024-03-04 20:48:15.000000000 +0300
+++ b/hw/ide/ich.c	2026-11-23 03:31:17.484349417 +0300
@@ -104,6 +104,160 @@
     ahci_init(&d->ahci, DEVICE(obj));
 }
 
+
+/* ---- test model: Intel RST NVMe remapping (QEMU_AHCI_REMAP=n: the n-th
+   ich9-ahci). The ABAR grows to 512 KB: VSCAP (A4h) bit 0, REMAP_CAP
+   (800h) one bit per device, its class code at 880h + i * 80h, its
+   registers at 16 KB + i * 16 KB. The NVMe controllers go on the hidden
+   bus "<id>.remap" and get no configuration cycles from the guest; the
+   model gives them BAR0 and memory decoding itself. Their INTx goes
+   nowhere (the guest polls). After Linux include/linux/ahci-remap.h. */
+#include "hw/pci/pci_host.h"
+#include "hw/pci/pci_bus.h"
+#include "hw/sysbus.h"
+#include "qapi/error.h"
+
+typedef struct IchRemap {
+    PCIDevice *ahci;
+    MemoryRegion abar, regs, vscap, win, mem, io;
+    AddressSpace as;
+    PCIBus *bus;
+    PCIDevice *nvme[3];
+    int count;
+    bool setup;
+} IchRemap;
+
+#define TYPE_ICH_REMAP_HOST "ich-remap-host"
+static const TypeInfo ich_remap_host_info = {
+    .name = TYPE_ICH_REMAP_HOST,
+    .parent = TYPE_PCI_HOST_BRIDGE,
+};
+
+static void ich_remap_setup(IchRemap *r)
+{
+    int devfn;
+    if (r->setup) {
+        return;
+    }
+    r->setup = true;
+    r->count = 0;
+    for (devfn = 0; devfn < 256 && r->count < 3; devfn++) {
+        PCIDevice *d = r->bus->devices[devfn];
+        if (!d || pci_get_word(d->config + PCI_CLASS_DEVICE) != 0x0108) {
+            continue;
+        }
+        r->nvme[r->count] = d;
+        pci_host_config_write_common(d, PCI_BASE_ADDRESS_0, pci_config_size(d),
+                                     0x10000000u * (r->count + 1), 4);
+        pci_host_config_write_common(d, PCI_BASE_ADDRESS_1, pci_config_size(d), 0, 4);
+        pci_host_config_write_common(d, PCI_COMMAND, pci_config_size(d), 0x0006, 2);
+        r->count++;
+    }
+}
+
+static uint64_t ich_remap_regs_read(void *opaque, hwaddr addr, unsigned size)
+{
+    IchRemap *r = opaque;
+    hwaddr a = addr + 0x800;
+    ich_remap_setup(r);
+    if (a == 0x800) {
+        return (1u << r->count) - 1;
+    }
+    if (a >= 0x880 && a < 0x880 + 3 * 0x80 && ((a - 0x880) & 0x7f) == 0) {
+        int i = (a - 0x880) / 0x80;
+        return i < r->count ? 0x010802 : 0;
+    }
+    return 0;
+}
+
+static void ich_remap_regs_write(void *opaque, hwaddr addr, uint64_t v, unsigned size) { }
+
+static const MemoryRegionOps ich_remap_regs_ops = {
+    .read = ich_remap_regs_read, .write = ich_remap_regs_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t ich_remap_vscap_read(void *opaque, hwaddr addr, unsigned size)
+{
+    return addr == 4 ? 1 : 0;           /* A4h: remapping present */
+}
+
+static const MemoryRegionOps ich_remap_vscap_ops = {
+    .read = ich_remap_vscap_read, .write = ich_remap_regs_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t ich_remap_win_rw(IchRemap *r, hwaddr addr, uint64_t val, unsigned size, bool write)
+{
+    int i = addr / 0x4000;              /* the window starts at 16 KB */
+    uint8_t buf[8];
+    hwaddr a;
+    ich_remap_setup(r);
+    if (i >= r->count) {
+        return write ? 0 : ~0ull;
+    }
+    a = 0x10000000ull * (i + 1) + (addr & 0x3fff);
+    if (write) {
+        stn_le_p(buf, size, val);
+        address_space_write(&r->as, a, MEMTXATTRS_UNSPECIFIED, buf, size);
+        return 0;
+    }
+    address_space_read(&r->as, a, MEMTXATTRS_UNSPECIFIED, buf, size);
+    return ldn_le_p(buf, size);
+}
+
+static uint64_t ich_remap_win_read(void *o, hwaddr a, unsigned sz) { return ich_remap_win_rw(o, a, 0, sz, false); }
+static void ich_remap_win_write(void *o, hwaddr a, uint64_t v, unsigned sz) { ich_remap_win_rw(o, a, v, sz, true); }
+
+static const MemoryRegionOps ich_remap_win_ops = {
+    .read = ich_remap_win_read, .write = ich_remap_win_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 8 },
+    .impl = { .min_access_size = 1, .max_access_size = 8 },
+};
+
+static void ich_remap_set_irq(void *opaque, int irq, int level) { }
+static int ich_remap_map_irq(PCIDevice *d, int pin) { return pin; }
+
+static MemoryRegion *ich_remap_init(PCIDevice *dev, MemoryRegion *ahci_mem)
+{
+    IchRemap *r = g_new0(IchRemap, 1);
+    DeviceState *host;
+    const char *id = DEVICE(dev)->id ? DEVICE(dev)->id : "ahci";
+    g_autofree char *busname = g_strdup_printf("%s.remap", id);
+
+    r->ahci = dev;
+    memory_region_init(&r->abar, OBJECT(dev), "ahci-remap-abar", 512 * 1024);
+    memory_region_add_subregion(&r->abar, 0, ahci_mem);
+    memory_region_init_io(&r->vscap, OBJECT(dev), &ich_remap_vscap_ops, r, "ahci-remap-vscap", 0x10);
+    memory_region_add_subregion_overlap(&r->abar, 0xa0, &r->vscap, 1);
+    memory_region_init_io(&r->regs, OBJECT(dev), &ich_remap_regs_ops, r, "ahci-remap-regs", 0x800);
+    memory_region_add_subregion_overlap(&r->abar, 0x800, &r->regs, 1);
+    memory_region_init_io(&r->win, OBJECT(dev), &ich_remap_win_ops, r, "ahci-remap-nvme", 3 * 0x4000);
+    memory_region_add_subregion(&r->abar, 0x4000, &r->win);
+
+    memory_region_init(&r->mem, OBJECT(dev), "ahci-remap-mem", UINT64_MAX);
+    memory_region_init(&r->io, OBJECT(dev), "ahci-remap-io", 0x10000);
+    address_space_init(&r->as, &r->mem, "ahci-remap");
+    host = qdev_new(TYPE_ICH_REMAP_HOST);
+    r->bus = pci_root_bus_new(host, busname, &r->mem, &r->io, 0, TYPE_PCI_BUS);
+    pci_bus_irqs(r->bus, ich_remap_set_irq, r, PCI_NUM_PINS);
+    pci_bus_map_irqs(r->bus, ich_remap_map_irq);
+    PCI_HOST_BRIDGE(host)->bus = r->bus;
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(host), &error_fatal);
+    return &r->abar;
+}
+
+static void ich_remap_register_types(void)
+{
+    type_register_static(&ich_remap_host_info);
+}
+type_init(ich_remap_register_types)
+
 static void pci_ich9_ahci_realize(PCIDevice *dev, Error **errp)
 {
     struct AHCIPCIState *d;
@@ -112,9 +266,32 @@
     d = ICH9_AHCI(dev);
     int ret;
 
-    ahci_realize(&d->ahci, DEVICE(dev), pci_get_address_space(dev), 6);
+    ahci_realize(&d->ahci, DEVICE(dev), pci_get_address_space(dev),
+                 getenv("QEMU_AHCI_PORTS") ? atoi(getenv("QEMU_AHCI_PORTS")) : 6);
 
